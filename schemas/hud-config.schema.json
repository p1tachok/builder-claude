{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pitachok.local/schemas/hud-config.schema.json",
  "title": "Pitachok HUD config (schemaVersion 1)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "hudId",
    "hudType",
    "version",
    "status",
    "assets",
    "colors",
    "radar",
    "dialogStyle"
  ],
  "$defs": {
    "hex": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^#[0-9a-fA-F]{6}$"
    },
    "asset": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "file"
          ],
          "properties": {
            "file": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "dataUri"
          ],
          "properties": {
            "dataUri": {
              "type": "string",
              "pattern": "^data:image/(png|jpeg|webp);base64,[A-Za-z0-9+/]+={0,2}$"
            }
          }
        }
      ]
    }
  },
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "hudId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$"
    },
    "developerId": {
      "type": [
        "string",
        "null"
      ],
      "description": "Информационное поле. Источник истины — сессия на backend."
    },
    "distribution": {
      "enum": [
        "free",
        "paid"
      ]
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "status": {
      "enum": [
        "draft",
        "published",
        "revoked"
      ]
    },
    "assets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "auth": {
          "$ref": "#/$defs/asset"
        },
        "dialogBackground": {
          "$ref": "#/$defs/asset"
        },
        "icons": {
          "type": "object",
          "additionalProperties": false,
          "propertyNames": {
            "enum": [
              "active_wanted",
              "armour",
              "breath",
              "cash",
              "circle",
              "health",
              "hunger",
              "inactive_wanted",
              "radar",
              "wanted_back",
              "weapon_back",
              "zone"
            ]
          },
          "patternProperties": {
            ".*": {
              "$ref": "#/$defs/asset"
            }
          }
        },
        "logos": {
          "type": "object",
          "propertyNames": {
            "pattern": "^([1-9]|1[0-9]|2[01])$"
          },
          "patternProperties": {
            ".*": {
              "$ref": "#/$defs/asset"
            }
          }
        },
        "weapons": {
          "type": "object",
          "propertyNames": {
            "pattern": "^([0-9]|[1-3][0-9]|4[0-8])$"
          },
          "patternProperties": {
            ".*": {
              "$ref": "#/$defs/asset"
            }
          }
        }
      }
    },
    "colors": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "chat": {
          "$ref": "#/$defs/hex"
        },
        "radicalWindows": {
          "$ref": "#/$defs/hex"
        },
        "hp": {
          "$ref": "#/$defs/hex"
        },
        "armor": {
          "$ref": "#/$defs/hex"
        },
        "food": {
          "$ref": "#/$defs/hex"
        }
      }
    },
    "captureBoard": {
      "enum": [
        null,
        "normal",
        "black",
        "old",
        "custom"
      ]
    },
    "radar": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "shape": {
          "enum": [
            null,
            "oval",
            "round",
            "square",
            "rect"
          ]
        },
        "outlineSize": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 5,
          "multipleOf": 0.01
        },
        "outlineColor": {
          "$ref": "#/$defs/hex"
        }
      }
    },
    "dialogStyle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            null,
            "normal",
            "custom"
          ]
        }
      }
    },
    "metadata": {
      "type": "object"
    },
    "hudType": {
      "enum": [
        "free",
        "paid"
      ]
    }
  }
}