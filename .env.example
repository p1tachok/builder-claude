# Данные сервера (SQLite, артефакты, ключи подписи). Не коммитить!
PITACHOK_DATA_DIR=./server/data
PORT=8080
HOST=127.0.0.1
# 1 — если сервер стоит за reverse proxy с HTTPS (доверять X-Forwarded-For)
TRUST_PROXY=0
OFFLINE_GRACE_HOURS=72
MIN_LOADER_VERSION=0.0.0
# GitHub-реестр (необязательно). Токен только на сервере, права: contents:write на один репозиторий.
GITHUB_REPO=owner/pitachok-hud-registry
GITHUB_BRANCH=main
GITHUB_TOKEN=
# Публичный адрес API (вшивается в .build для loader), например https://api.example.com/api/v1 -> указывать БЕЗ /api/v1
PUBLIC_URL=https://api.example.com
